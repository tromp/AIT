-- Sort a list of binary lists lexicographically (mergesort version).
-- [] < 0:* < 1:*
-- by Artyom Bologov (https://github.com/aartaka)
let
  true = \x\y.x;
  false = \x\y.y;
  not = \b\t\f.b f t;
  nil = false;
  cons = \a\b\p.p a b;

  -- The cons case of a list gets head, tail and the (ignored) nil case.
  -- Here that last argument z is bound after the body, which doesn't use
  -- it, so the body sits one lambda shallower.
  leq = \a\b.a (\ahead\atail.
                  let r = (b true ahead (not ahead))
                          (leq atail (b false))
                          ahead
                  in \z.r)
               true;

  insert = \x. let insertx = \list.
    let xlist = cons x list in
    list
    (\head\tail\lx.
      leq head x
      (cons head (insertx tail ))
      xlist )
    xlist
  in insertx;

  sort = \list.		-- 290 bits
    list (let go = 
           (\head\tail\z.
             insert head (tail go z))
          in go) nil;

in sort

