let
  0    =   \f\x. x;
  succ = \n\f\x. n f (f x);
  1 = succ 0;
  2 = succ 1;
  3 = succ 2;
  4 = succ 3;
  5 = succ 4;
  6 = succ 5;
  7 = succ 6;
  8 = succ 7;
  9 = succ 8;
  10 = succ 9;
  isZero = \n\t\f. n (\_. f) t;
  -- multiplication, 19 bits
  mul = \a\b\f.a(b f);
  -- square, 16 bits
  T = \x\y.y x;
  sq = \x\f.x(x f);
  -- subtraction, 56 bits
  sub = \m\n. n (\p. \f. \x. p (\g. \h. h (g f)) (\u. x) (\u. u)) m;
  true  = \t\f.t;
  false = \t\f.f;
  lt  = \m\n\t\f.  n T (\_.f) (m T (\_.t));
  leq = \n\m\t\f.  n T (\_.t) (m T (\_.f));

  -- square root, rounded down, 116 bits
  -- go n = leq (sq n1) sqr (go n1) n where n1 = succ n, with leq expanded:
  -- its second half, sqr T (\_.n), doesn't use n1, so it stays outside the let
  sqrt = \sqr. let
    go = \n. (let n1 = succ n in sq n1 T (\_.go n1)) (sqr T (\_.n))
  in go 0

in sqrt -- 10
