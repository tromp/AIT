-- simplest Church numeral equality uses tuple numerals
let
  0 = \x\y.y;
  id = \x.x;
  1 = id;
  2 = \f\x.f(f x);
  3 = \f\x.f(f(f x));
  4 = 2 2;
  false = 0;
  true = \x\y.x;
  T = \x\y. y x;
  K = true;
  -- (T^m A) (T^n B) =
  --   if n < m then B (T^{m-1-n} A)
  --            else A (T^{n-m} B)
  -- let A=id; B=T in \m\n.m T A (n T B);
  -- n<m -- B (T* A) = T+ id   -- T+ id (K(K false)) (K true) = K false (K true) = false
  -- n>m -- A (T+ B) = T+ T    -- T+ T  (K(K false)) (K true) = K false (K true) = false
  -- m=n -- A B      = T       -- T * (K true) = true
  eq = \m\n. let T = \x\y. y x in m T id (n T T) (K(K false)) (K true);
in eq -- 2 1
