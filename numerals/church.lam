let
  C0 = \f\x. x;
  C1 = \f.f;
  d0 = \n\f\x.n f(n f x);                               -- 30 bits
  d1 = \n. let succ = \n\f\x. f(n f x) in succ (d0 n);  -- 35 bits
in d0 --  (d1 (d0 (d1 (d0 C1)))) -- 2 + 2 + #0*5 + #1*4 + 35 + 30 <= 5 * |n| + 69

-- (λ (λ 2 (1 (2 (1 (2 (λ 1)))))) (λ λ λ 2 (4 3 2 1))) (λ λ λ 3 2 (3 2 1))
-- 42_2 = 101010
