-- computes infinite Laver table as in section 3.4 of https://arxiv.org/pdf/1810.00548.pdf
let
  0 = \s\z. z;
  succ = \n\s\z. s n; -- Scott numerals
  1 = succ 0;
  2 = succ 1;
  3 = succ 2;
  4 = succ 3;
  5 = succ 4;
  6 = succ 5;
  7 = succ 6;

  -- cons = \h\t\z.z t h; -- applying to head last gives trivial list indexing
  -- idx n list = list n
  -- idx 0 (cons h t) = cons h t 0 = 0 t h = h
  -- idx (succ n) (cons h t) = cons h t (succ n) = (succ n) t h = t n

-- laver b 0 = b
-- laver b a = cycle (go (a-1)) !! b
-- go a = cycle (0 : reverse (takeWhile (/= 0) (iterate (laver a) a)))

  -- 208 bits
  -- The recursions are written out as self-application knots. Inside go,
  -- one \x.x x (dbl) serves the three loops (go's own, iterate and revpos)
  -- and the recursive call laver x a1 = dbl self x a1.
  -- The list ls does not depend on the knot variable r, so it is bound
  -- outside the knot's lambdas (r and z).
  laver = (\x.x x) (\self\a\b. a (\a1. let
    go = let
      dbl = \x.x x;
      revpos = dbl (\rp\t\h\r.h (\_. t (rp rp) (\z.z r h)) r); -- reverse positive prefix and append r
      iterate = dbl (\it\x\z.z (it it (dbl self x a1)) x)
    in dbl (let ls = iterate a1 revpos in \r\z.z (ls (r r)) z)
  in go b) b)
in
  laver -- 6 6
