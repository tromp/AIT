-- Version of bf.lam that ignores unknown characters in brainf*ck source code,
-- like the traditional version did.
\io.let
  id    = \x.x;
  true  = \x\y.x; -- 0
  false = \x\y.y; -- 1
  nil   = false;
  not   = \x\a\b.x b a;

  left  = \cnt\x\rs\ls.ls (\l.cnt l (\p.p x rs));
  right = \cnt\x\rs\ls.rs cnt (\p.p x ls);

  putc  = \cnt\x\rs\ls\io.\p.p x (cnt x rs ls io);
  getc  = \cnt\x\rs\ls\io.io (\i.cnt i rs ls);

  alu   = \n.let alu = \xs\cnt.xs
           (\x\xs\dummy.alu xs (\xs\f.cnt (\p.p (f x) xs) (n x f id)))
           (cnt xs not) in alu;

  isz   = \x.alu id x false false;
  loop  = \body\cnt.let loop = \x.isz x (cnt x) (body loop x) in loop;
  -- again is bound outside of \cont\cell, which it does not depend on
  loop  = \body.let loop = let again = \c.body (loop c) in \cont\cell.
    cell (let foo = \b\l.b (l foo) again in foo) cont cell in loop;

  -- explicit knot (self self = parse), so that next, which parses the rest of
  -- the program and hands it to k, can be shared between op and [
  parse = (\x.x x) (\self.
    let next = \k\u\xs.xs (self self) k in
    -- arith and op are bound in parallel, so that op isn't shifted by arith
    (\arith\op.
    let nop = op id;
        b = \t\f\x.x (\bit\x.bit t f x);
        0 = \t.b t nop;
        1 = b nop
    in
    0(b(1(b(1(b(1(1(op (arith not))))                              -- -
               (b(b(op getc)                                       -- ,
                   (op (arith id)))                                -- +
                 (0(op putc)))))                                   -- .
           (1(1(b(0(op left))                                      -- <
                 (0(op right)))))))                                -- >
       (0(1(1(b(1(1(next (\body.op (loop body) body))))           -- [
               (0(1(\u\xs.\p.p id xs))))))))                      -- ]
    ) (\n\cnt\x.cnt (alu n x true))
      (\op.next (\cnt\xs.\p.p (\f.op (cnt f)) xs)));
  zeros = \p.p (let two = \f\x.f (f x); three = \f.f (f (f (\xs\p.p true xs)))
                in  three two nil) zeros;
  cont = \p.zeros (p (\x\ls\rs\io.nil)) p
in io parse cont
