-- given a list and a program, output the pair of <program length, list>
--  used for exercising pairup program
let
 true = \x\y.x;
 zero = true;
 false = \x\y.y;
 one = false;
 nil = false;

 -- increment or decrement a bigendian binary number
 -- ccps version
 -- explicit knot (self self = indec), so that indec which is shared outside the lambdas
 indec = (\x.x x) (\self\which.let again = self self which in
   \cont\done\list.list (\msb.again (\r\dummy.which msb cont done (\z.z (\x\y.msb y x) r)) (\r\dummy.done (\z.z msb r))) (cont list));

 inc = indec (\b\x\y.b y x) (\r\z.z zero r) (\r.r);

 countlen = \list.list (\h\t\z.inc (countlen t)) false;
 pairlen = \list\prog\z.z (countlen prog) list

in pairlen
