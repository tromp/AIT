-- showing KP(x) <= KO(x) + 540

\io\p. let
  -- one fixpoint combinator shared by the three recursive functions
  Y = \f. (\x. x x) (\x. f (x x));
  id = \x. x;
  true = \t\f. t;
  false = \t\f. f;
  omega = Y id;

  -- replace `omega` used as the initial variable context by the closest
  -- variable; this is fine for closed terms as required by KP.
  -- (IF_DIRTY = false gives 562 bits)
  IF_DIRTY = true;

  -- generic evaluator -- really just parser + translation to HOAS
  --
  --   uni :: ((t -> t) -> t)     -- abstraction
  --       -> (t -> (t -> t))     -- application
  --       -> (([t] -> t) -> [Bool] -> r)
  --          -- continuation taking program, remainder of input
  --       -> [Bool]              -- input
  --       -> r
  --
  -- (the returned program takes a context defining its free variables)
  -- parser after int.lam (cons' cells, the variable's code as its lookup,
  -- the stream selecting its own tail), ported by a9lim
  uni = \abs\app. Y (\uni0. \cnt. \xs.
      xs (\a. a) (\next. xs (\_. cnt) (xs xs next))
      (\b1. uni0 (\v1. b1
          (cnt (\ctx. abs (\v2. v1 (\zx\zy. zx v2 (zy ctx)))))
          (uni0 (\v2. cnt (\ctx. app (v1 ctx) (v2 ctx)))))));

  -- the KP side, scoped to the argument of p that uses it
  kp = let
    -- data T = A (V -> V)  -- abstraction
    --        | V           -- free variable
    --        | O           -- "Omega" marking the end of the available input
    caseT = \t\a\v\o. t a v o;
    V = \a\v\o. v;
    O = \a\v\o. o;

    nfT = Y (\nfT. \t. caseT t
      (\f. nfT (f V))  -- A: apply to a free variable to further reduce whnf
      t                -- V: done, this is a normal form
      t);              -- O: done, we've hit the "Omega"

    appT = \t\u. caseT t
      (\f. f u)        -- A: apply
      (nfT u)          -- V: reduce argument to normal form next
      t;               -- O: preserve O
    appT = \t. caseT t (\f. f) nfT (\u. t); -- same but smaller

    -- pass T's abstraction A = \f. \a\v\o. a f and its application appT to
    -- a builder that is generic in both, as uni is
    withT = \b. b (\f. \a\v\o. a f) appT;

    -- generic in abstraction and application
    boolT = \abs\x. abs (\t. abs (\f. x t f));
    consT = \abs\app\x\xs. abs (\p. app (app p x) xs);

    rest = \prog.
      let go = Y (\go. \is\xs.
            caseT (nfT (appT (prog (IF_DIRTY xs omega)) (is O)))
              xs -- A: impossible case
              xs -- V: we've found the remainder
              -- O: start over with a longer input list
              (xs (\x\xs. go (\tl. is (withT (\abs\app.
                consT abs app (boolT abs x) tl))) xs)))
      in  go id
  in withT uni rest
in
  p (uni id id (\prog\rs. prog (IF_DIRTY prog omega) rs) io)
    (kp io)

-- template for showing KO(x) <= KP(x) + 15:
-- 00 01 01 <prog> 10 01 01 110 = \io. <prog> io (\t\f. t)
